# Backend Configuration
PORT=3001

# Claude CLI Configuration
# Đường dẫn tuyệt đối tới binary của Claude Code
# Ví dụ: /usr/local/bin/claude hoặc C:\Users\YourName\AppData\Roaming\npm\claude.cmd
CLAUDE_BIN_PATH=/Users/tampv/.nvm/versions/node/v22.14.0/bin/claude

# Logging
# levels: error, warn, info, debug
LOG_LEVEL=info

# Session-end key for Claude stream termination workaround
# true/1/on/yes: append __CLAUDE_SESSION_END__ requirement and detect it in stream
# false/0/off/no: disable key-based behavior
ENABLE_CLAUDE_SESSION_END=false
