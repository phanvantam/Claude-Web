# Cấu hình Nginx cho Claude Web (mẫu dựa trên production thực tế)
# Backend chạy qua PM2, Nginx reverse proxy toàn bộ.
#
# QUAN TRỌNG: Phải có proxy_buffering off cho location /socket.io/
# Nếu thiếu → event bị buffer → UI treo "Đang xử lý..."

server {
    listen 80;
    listen 443 ssl http2;
    server_name your-domain.com;

    # SSL config (thay đường dẫn cert phù hợp)
    ssl_certificate     /path/to/fullchain.pem;
    ssl_certificate_key /path/to/privkey.pem;

    # Redirect HTTP → HTTPS
    if ($server_port !~ 443) {
        rewrite ^(/.*)$ https://$host$1 permanent;
    }

    # ── Socket.io WebSocket (tách riêng để tối ưu) ──
    location /socket.io/ {
        proxy_pass http://127.0.0.1:4000/socket.io/;
        proxy_http_version 1.1;

        # BẮT BUỘC cho WebSocket upgrade
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Tắt buffering — BẮT BUỘC để events không bị delay
        proxy_buffering off;

        # Timeout cao — Claude có thể xử lý lâu
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_connect_timeout 60s;
    }

    # ── Tất cả request khác (API + static) ──
    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Fallback WebSocket support (phòng trường hợp Socket.io dùng path khác)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
